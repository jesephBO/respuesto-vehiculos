# Copiar a .env en la VM del API y ajustar.
#
# DB_HOST es obligatorio: debe ser la IP privada (o hostname resoluble
# dentro de la red interna) de la VM/contenedor donde corre Postgres.
# NO uses "db-vehiculos" ni "localhost" aquí, eso solo funciona con
# docker-compose.local.yml (todo en un solo host, para desarrollo).
DB_HOST=10.0.0.X
DB_PORT=5432

DB_NAME=vehiculos_db
DB_USER=postgres
DB_PASSWORD=postgres

# Solo poner en true para cargar datos ficticios una única vez (ver README).
# Debe quedar en false el resto del tiempo, incluido en producción.
SEED_ENABLED=false
